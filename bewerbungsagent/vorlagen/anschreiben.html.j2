{% import "_bausteine.html.j2" as m with context %}
{{ m.kopfbereich(b.betreff) }}
<style>
/* DIN 5008 Form B: Anschriftfeld 45 mm von oben, Falzmarken bei 105 und 210 mm, Lochmarke bei 148,5 mm */
:root { --grad: {{ schriftgrad }}pt; }
.brief { position: relative; }
.marke { position: absolute; left: 5.6mm; width: 3.4mm; height: 0.25mm; background: #b9bdc7; }
.marke--falz1 { top: 105mm; }
.marke--loch { top: 148.5mm; width: 5mm; }
.marke--falz2 { top: 210mm; }

.briefkopf { position: absolute; left: 25mm; right: 20mm; top: 13mm; display: flex; justify-content: space-between; gap: 10mm; }
.briefkopf h1 { font-size: 21pt; letter-spacing: -0.03em; line-height: 1; }
.briefkopf .wunsch { margin-top: 1.8mm; color: var(--grau); font-size: 9.6pt; }
.briefkopf .kontakte { display: grid; gap: 1.1mm; font-size: 8.2pt; text-align: right; justify-items: end; }
.briefkopf .kontakte li { display: flex; align-items: center; gap: 1.6mm; flex-direction: row-reverse; white-space: nowrap; }
.briefkopf .kontakte li:nth-child(n+5) { display: none; }
.briefkopf .foto { width: 17mm; height: 17mm; border-radius: 50%; padding: 0.6mm; background: var(--band); flex: none; }
.briefkopf .foto img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 0.6mm solid #fff; }
.kopf-links { display: flex; gap: 4.5mm; align-items: center; }

.anschrift { position: absolute; left: 20mm; top: 45mm; width: 85mm; height: 45mm; padding-left: 5mm; }
.ruecksende { position: absolute; left: 5mm; top: 12.4mm; font-size: 6.6pt; color: var(--grau); white-space: nowrap; border-bottom: 0.2mm solid var(--linie); padding-bottom: 0.4mm; }
.empfaenger { position: absolute; left: 5mm; top: 17.7mm; font-size: 10pt; line-height: 1.38; }

.info { position: absolute; left: 125mm; right: 20mm; top: 50mm; display: grid; gap: 2.2mm; font-size: 8.4pt; }
.info dt { color: var(--grau); font-size: 7.6pt; }
.info dd { margin: 0; }

.inhalt {
  position: absolute; left: 25mm; right: 20mm; top: 97mm; bottom: 22mm;
  display: flex; flex-direction: column; overflow: hidden;
}
.betreff { font-family: var(--kopf); font-size: calc(var(--grad) + 2.4pt); font-weight: 680; letter-spacing: -0.015em; line-height: 1.22; }
.referenz { margin-top: 1mm; color: var(--grau); font-size: 8.4pt; }
.text { margin-top: 7mm; font-size: var(--grad); line-height: 1.5; }
.text p + p { margin-top: calc(var(--grad) * 0.62); }
.gruss { margin-top: calc(var(--grad) * 0.62); }
.unterschrift-bild { height: 13mm; margin: 1.5mm 0 0.5mm; }
.unterschrift-luecke { height: 9mm; }
.name { font-weight: 560; }
.anlagen { margin-top: 5mm; font-size: 8.2pt; color: var(--grau); }
.anlagen strong { color: var(--tinte); font-weight: 560; }

.brieffuss { position: absolute; left: 25mm; right: 20mm; bottom: 9mm; display: flex; justify-content: space-between; font-size: 7.2pt; color: var(--leise); border-top: 0.2mm solid var(--linie); padding-top: 2mm; }
</style>
</head>
<body>
<div id="seiten">
<section class="blatt brief">
  <div class="band"></div>
  <span class="marke marke--falz1"></span><span class="marke marke--loch"></span><span class="marke marke--falz2"></span>

  <header class="briefkopf">
    <div class="kopf-links">
      {% if foto %}<div class="foto"><img src="{{ foto }}" alt=""></div>{% endif %}
      <div>
        <h1>{{ p.name }}</h1>
        {% if p.titel %}<p class="wunsch">{{ p.titel }}</p>{% endif %}
      </div>
    </div>
    {{ m.kontakte(p) }}
  </header>

  <div class="anschrift">
    <p class="ruecksende">{{ p.name }}{% if p.strasse %}, {{ p.strasse }}{% endif %}{% if p.plz_ort %}, {{ p.plz_ort }}{% endif %}</p>
    <div class="empfaenger">{% for z in b.empfaenger[:6] %}{{ z }}<br>{% endfor %}</div>
  </div>

  <dl class="info">
    {% if b.referenz %}<div><dt>Ihre Anzeige</dt><dd>{{ b.referenz }}</dd></div>{% endif %}
    {% if p.telefon %}<div><dt>Telefon</dt><dd class="zahl">{{ p.telefon }}</dd></div>{% endif %}
    <div><dt>Datum</dt><dd>{{ b.ort_datum }}</dd></div>
  </dl>

  <div class="inhalt" data-einpassen="{{ schriftgrad }},{{ schriftgrad - 0.3 }},{{ schriftgrad - 0.6 }},{{ schriftgrad - 0.9 }},{{ schriftgrad - 1.2 }}">
    <h2 class="betreff">{{ b.betreff }}</h2>
    <div class="text">
      <p>{{ b.anrede }}</p>
      {% for x in b.absaetze %}<p>{{ x }}</p>{% endfor %}
      <p class="gruss">{{ b.gruss }}</p>
      {% if b.unterschrift_uri %}<img class="unterschrift-bild" src="{{ b.unterschrift_uri }}" alt="">{% else %}<div class="unterschrift-luecke"></div>{% endif %}
      <p class="name">{{ p.name }}</p>
      {% if b.anlagen %}<p class="anlagen"><strong>Anlagen</strong> {{ b.anlagen | join(", ") }}</p>{% endif %}
    </div>
  </div>

  <footer class="brieffuss"><span>{{ p.name }}</span><span>{{ ort_zeile(p.email, kurz_url(p.web)) }}</span></footer>
</section>
</div>
<script>{{ seiten_js }}</script>
</body>
</html>
