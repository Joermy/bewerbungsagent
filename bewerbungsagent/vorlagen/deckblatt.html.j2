{% import "_bausteine.html.j2" as m with context %}
{{ m.kopfbereich("Bewerbung " ~ p.name) }}
<style>
.deck { display: grid; grid-template-columns: 62mm 1fr; }
.flaeche-links { background: var(--band); position: relative; }
{% if farben.spektrum %}.flaeche-links { background: linear-gradient(185deg, #ff7a3d 0%, #ff3d7f 30%, #9b5cff 64%, #38b6ff 100%); }{% endif %}
.flaeche-links::after {
  content: ""; position: absolute; inset: 0;
  background: repeating-linear-gradient(0deg, rgba(255,255,255,.08) 0 0.25mm, transparent 0.25mm 7mm);
}
.deck-foto {
  position: absolute; left: 30mm; top: 36mm; width: 58mm; height: 58mm; border-radius: 50%;
  border: 1.6mm solid #fff; overflow: hidden; z-index: 3; background: #fff;
  box-shadow: 0 3mm 9mm rgba(20, 22, 30, .18);
}
.deck-foto--eckig { border-radius: 6mm; }
.deck-foto img { width: 100%; height: 100%; object-fit: cover; }
.rechts { position: relative; display: flex; flex-direction: column; padding: 112mm 18mm 18mm 16mm; }
.deck:not(.mit-foto) .rechts { padding-top: 56mm; }
.art { font-size: 11pt; color: var(--grau); }
.position { margin-top: 3mm; line-height: 1.04; letter-spacing: -0.035em; hyphens: manual; }
.firma { margin-top: 6mm; font-size: 12pt; }
.firma span { color: var(--grau); }
.person { margin-top: auto; }
.person h2 { font-size: 17pt; letter-spacing: -0.025em; }
.person .kontakte { display: grid; gap: 1.4mm; margin-top: 4mm; font-size: 8.8pt; }
.person .kontakte li { display: flex; gap: 2mm; align-items: center; }
.verzeichnis { margin-top: 12mm; border-top: 0.25mm solid var(--linie); padding-top: 4mm; }
.verzeichnis h3 { font-family: var(--text); font-size: 8.4pt; font-weight: 620; color: var(--grau); margin-bottom: 2mm; }
.verzeichnis li { display: flex; justify-content: space-between; padding: 1.1mm 0; border-bottom: 0.2mm dotted var(--linie); font-size: 9.4pt; }
.verzeichnis li span:last-child { color: var(--grau); font-variant-numeric: tabular-nums; }
</style>
</head>
<body>
<div id="seiten">
<section class="blatt deck{% if foto %} mit-foto{% endif %}">
  <div class="flaeche-links"></div>
  {% if foto %}<div class="deck-foto{% if design.foto_form == 'eckig' %} deck-foto--eckig{% endif %}"><img src="{{ foto }}" alt="Foto von {{ p.name }}"></div>{% endif %}
  <div class="rechts">
    <p class="art">{{ "Bewerbung um einen Ausbildungsplatz als" if a.art == "Ausbildung" else "Bewerbung als" }}</p>
    {% set laengstes = (a.position or "").split() | map("length") | max %}
    <h1 class="position" style="font-size: {{ 30 if laengstes <= 12 else (25 if laengstes <= 18 else 21) }}pt">{{ a.position }}</h1>
    {% if a.firma %}<p class="firma"><span>bei</span> {{ a.firma }}</p>{% endif %}
    <div class="person">
      <h2>{{ p.name }}</h2>
      {{ m.kontakte(p) }}
      {% if a.inhalt %}
      <nav class="verzeichnis">
        <h3>Inhalt</h3>
        <ul>{% for name, seite in a.inhalt %}<li><span>{{ name }}</span><span>{{ seite }}</span></li>{% endfor %}</ul>
      </nav>
      {% endif %}
    </div>
  </div>
</section>
</div>
</body>
</html>
