# E-Mail-Versand (Gmail: App-Passwort unter myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=deine.adresse@gmail.com
SMTP_PASSWORD=

# Modell: Schluessel fuer OpenAI-kompatible Dienste oder die Anthropic-API (llm.backend: anthropic)
LLM_API_KEY=
ANTHROPIC_API_KEY=

# Weitere Jobquellen (in config.yaml unter quellen einschalten)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=

# Jobalarme aus dem Postfach lesen (nur lesen; Gmail: imap.gmail.com mit App-Passwort)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
